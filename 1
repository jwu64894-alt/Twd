local function getThumbnail(id, isBundle)
    if isBundle then
        return "rbxthumb://type=BundleThumbnail&id=" .. tostring(id) .. "&w=420&h=420"
    end
    
    return "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=420&h=420"
end

local function formatPrice(price)
    if price == nil then
        return "Preço indisponível"
    end
    
    local number = tonumber(price)
    
    if not number then
        return "Preço indisponível"
    end
    
    if number <= 0 then
        return "Grátis"
    end
    
    return tostring(number) .. " Robux"
end

local function promptPurchase(item)
    local purchaseId
    
    if item.IsBundle then
        purchaseId = tonumber(item.ThumbnailId or item.Id)
    else
        purchaseId = tonumber(item.Id)
    end
    
    if not purchaseId or purchaseId <= 0 then
        return
    end
    
    remote:FireServer(
    "Comprar",
    purchaseId,
    item.Name,
    item.AssetType,
    item.ShoePair,
    item.IsBundle == true
    )
end

local function refreshCards()
    for _, card in ipairs(itemScroll:GetChildren()) do
        if card:IsA("Frame") then
            local itemId = tonumber(card:GetAttribute("ItemId"))
            local useButton = card:FindFirstChild("UseButton")
            local useLabel = useButton and useButton:FindFirstChild("UseLabel")
            
            if activeItems[itemId] then
                card.BackgroundColor3 = GREEN
                
                if useLabel then
                    useLabel.Text = "ATIVO"
                    useLabel.TextColor3 = WHITE
                    useLabel.Visible = true
                end
            else
                card.BackgroundColor3 = CARD
                
                if useLabel then
                    useLabel.Text = "USAR"
                    useLabel.TextColor3 = PURPLE_LIGHT
                    useLabel.Visible = true
                end
            end
        end
    end
end

