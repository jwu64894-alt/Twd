local function isShoeAssetType(assetType)
    return assetType == "LeftShoeAccessory"
    or assetType == "RightShoeAccessory"
end
 
local function getShoeAccessoryType(assetType)
    if assetType == "LeftShoeAccessory" then
        return Enum.AccessoryType.LeftShoe
    elseif assetType == "RightShoeAccessory" then
        return Enum.AccessoryType.RightShoe
    end
    
    return nil
end
 
local function getFreeLayeredOrder(accessories)
    local usedOrders = {}
    
    for _, accessory in ipairs(accessories) do
        if accessory.Order ~= nil then
            usedOrders[tonumber(accessory.Order)] = true
        end
    end
    
    local order = 1
    
    while usedOrders[order] do
        order += 1
    end
    
    return order
end
 
