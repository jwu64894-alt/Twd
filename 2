local function toggleAccessory(player, humanoid, assetId, assetType, isLayered)
    local success, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)
    
    if not success or not description then
        return false
    end
    
    assetType = normalizeAssetType(assetType)
    
    if isLayered then
        local accessories = description:GetAccessories(true)
        local found = false
        local filtered = {}
        
        for _, accessory in ipairs(accessories) do
            if tonumber(accessory.AssetId) == tonumber(assetId) then
                found = true
            else
                table.insert(filtered, accessory)
            end
        end
        
        if found then
            if not pcall(function()
                description:SetAccessories(filtered, true)
            end) then
            return false
        end
        
        if not pcall(function()
            humanoid:ApplyDescriptionResetAsync(description)
        end) then
        return false
    end
    
    if catalogState[player] then
        catalogState[player].Accessories[assetId] = nil
    end
    
    removeEquippedState(player, assetId)
    remote:FireClient(player, "RefreshAvatar")
    
    return true
end
 
