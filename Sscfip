
-- AvatarPartsServer
-- ServerScriptService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InsertService = game:GetService("InsertService")

local event = ReplicatedStorage:FindFirstChild("AvatarPartsEvent")

if not event then
    event = Instance.new("RemoteEvent")
    event.Name = "AvatarPartsEvent"
    event.Parent = ReplicatedStorage
end

local cooldown = {}

event.OnServerEvent:Connect(function(player, id)
    if typeof(id) ~= "string" then return end
    if not id:match("^%d+$") then return end
    if #id > 15 then return end

    if cooldown[player] and os.clock() - cooldown[player] < 3 then
        return
    end
    cooldown[player] = os.clock()

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local success, asset = pcall(function()
        return InsertService:LoadAsset(tonumber(id))
    end)

    if not success or not asset then
        warn("Não foi possível carregar o asset.")
        return
    end

    local accessory = asset:FindFirstChildWhichIsA("Accessory", true)

    if accessory then
        local clone = accessory:Clone()

        local ok, err = pcall(function()
            humanoid:AddAccessory(clone)
        end)

        if not ok then
            clone:Destroy()
            warn(err)
        end
    else
        warn("O ID não é um acessório compatível.")
    end

    asset:Destroy()
end)

Players.PlayerRemoving:Connect(function(player)
    cooldown[player] = nil
end)



