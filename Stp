local function fillAllSourceBuffer(state, sourceName, requestVersion)
    local pages = state[sourceName .. "Pages"]
    local buffer = state[sourceName .. "Buffer"]
    
    if not pages or not buffer then
        state[sourceName .. "Finished"] = true
        return false
    end
    
    while #buffer == 0 and not state[sourceName .. "Finished"] do
        if requestVersion ~= catalogRequestVersion then
            return false
        end
        
        local success, results = pcall(function()
            return pages:GetCurrentPage()
        end)
        
        if not success or not results then
            state[sourceName .. "Finished"] = true
            break
        end
        
        for _, data in ipairs(results) do
            if requestVersion ~= catalogRequestVersion then
                return false
            end
            
            local item
            
            if sourceName == "asset" then
                item = assetToAllItem(data, state.seenIds)
            else
                item = bundleToItem(data, state.seenIds)
            end
            
            if item then
                table.insert(buffer, item)
            end
        end
        
        if pages.IsFinished then
            state[sourceName .. "Finished"] = true
            break
        end
        
        if #buffer == 0 then
            local successAdvance = pcall(function()
                pages:AdvanceToNextPageAsync()
            end)
            
            if not successAdvance then
                state[sourceName .. "Finished"] = true
                break
            end
        end
    end
    
    return #buffer > 0
end

local function appendAllCatalogPage(requestVersion)
    local state = allCatalogState
    
    if not state
        or state.requestVersion ~= requestVersion
        or requestVersion ~= catalogRequestVersion
        or state.loading then
        return false
    end
    
    state.loading = true
    
    local added = 0
    
    while added < ALL_PAGE_SIZE do
        if requestVersion ~= catalogRequestVersion then
            state.loading = false
            return false
        end
        
        if #state.assetBuffer == 0 and not state.assetFinished then
            fillAllSourceBuffer(state, "asset", requestVersion)
        end
        
        if #state.bundleBuffer == 0 and not state.bundleFinished then
            fillAllSourceBuffer(state, "bundle", requestVersion)
        end
        
        local assetAvailable = #state.assetBuffer > 0
        local bundleAvailable = #state.bundleBuffer > 0
        
        if not assetAvailable and not bundleAvailable then
            break
        end
        
        state.mixPosition += 1
        
        local item
        
        if state.mixPosition % 5 == 0 and bundleAvailable then
            item = table.remove(state.bundleBuffer, 1)
        elseif assetAvailable then
            item = table.remove(state.assetBuffer, 1)
        else
            item = table.remove(state.bundleBuffer, 1)
        end
        
        if item then
            table.insert(allItems, item)
            createCard(item)
            added += 1
        end
    end
    
    state.loading = false
    refreshCards()
    
    return added > 0
end

