local function stopCurrentEmote()
    local character = player.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return
    end
    
    local success, tracks = pcall(function()
        return humanoid:GetPlayingAnimationTracks()
    end)
    
    if not success or not tracks then
        return
    end
    
    for _, track in ipairs(tracks) do
        if track.Priority == Enum.AnimationPriority.Action
            or track.Priority == Enum.AnimationPriority.Action2
            or track.Priority == Enum.AnimationPriority.Action3
            or track.Priority == Enum.AnimationPriority.Action4 then
            
            pcall(function()
                track:Stop(0.15)
            end)
        end
    end
end

local function playNativeEmote(emoteName)
    local character = player.Character
    
    if not character then
        return false
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return false
    end
    
    stopCurrentEmote()
    
    local success, result = pcall(function()
        return humanoid:PlayEmoteAsync(emoteName)
    end)
    
    if not success then
        return false
    end
    
    return result == true
end

remote.OnClientEvent:Connect(function(action, id, extra)
    if action == "PlayEmote" then
        local played = playNativeEmote(id)
        
        if played then
            activeItems[extra] = true
        else
            activeItems[extra] = nil
        end
        
    elseif action == "Equipped" then
        activeItems[tonumber(id)] = true
        
        if currentFilter == "Vestindo" then
            task.defer(loadUsing)
        end
        
    elseif action == "Unequipped" then
        activeItems[tonumber(id)] = nil
        
        if currentFilter == "Vestindo" then
            task.defer(loadUsing)
        end
        
    elseif action == "ClearEquipped" then
        activeItems = {}
        
        if currentFilter == "Vestindo" then
            task.defer(loadUsing)
        end
        
    elseif action == "StopEmote" then
        stopCurrentEmote()
        
        if extra then
            activeItems[tonumber(extra)] = nil
        end
        
    elseif action == "RefreshAvatar" then
        if currentFilter == "Vestindo" then
            task.defer(loadUsing)
        end
    end
    
    refreshCards()
end)

