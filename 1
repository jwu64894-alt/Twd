local function fillHeadSource(state, source, requestVersion)
    if source.finished then
        return
    end
    
    while #source.buffer == 0 and not source.finished do
        if requestVersion ~= catalogRequestVersion then
            return
        end
        
        local success, results = pcall(function()
            return source.pages:GetCurrentPage()
        end)
        
        if not success or not results then
            source.finished = true
            break
        end
        
        for _, data in ipairs(results) do
            local item = createHeadItem(
            data,
            source.sourceType,
            state.seenIds
            )
            
            if item then
                table.insert(source.buffer, item)
            end
        end
        
        if source.pages.IsFinished then
            source.finished = true
            break
        end
        
        if #source.buffer == 0 then
            local advanceSuccess = pcall(function()
                source.pages:AdvanceToNextPageAsync()
            end)
            
            if not advanceSuccess then
                source.finished = true
                break
            end
        end
    end
