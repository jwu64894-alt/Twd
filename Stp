local function getAssetTypeFromAccessoryType(accessoryType)
    if not accessoryType then
        return nil
    end
    
    local typeName = string.gsub(
    tostring(accessoryType),
    "^Enum%.AccessoryType%.",
    ""
    )
    
    return accessoryTypeMap[typeName]
end

local function getCategoryFromAssetType(assetType)
    if not assetType then
        return "Acessórios"
    end
    
    if assetType == Enum.AvatarAssetType.LeftShoeAccessory
        or assetType == Enum.AvatarAssetType.RightShoeAccessory then
        return "Sapatos"
    end
    
    for category, types in pairs(categoryTypes) do
        for _, typeValue in ipairs(types) do
            if typeValue == assetType then
                return category
            end
        end
    end
    
    return "Acessórios"
end

local function loadUsing()
    usingLoadVersion += 1
    local requestVersion = usingLoadVersion
    
    local character = player.Character
    if not character then
        if requestVersion == usingLoadVersion then
            clearItems()
            allItems = {}
            activeItems = {}
        end
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        if requestVersion == usingLoadVersion then
            clearItems()
            allItems = {}
            activeItems = {}
        end
        return
    end
    
    local success, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)
    
    if requestVersion ~= usingLoadVersion then
        return
    end
    
    if not success or not description then
        clearItems()
        allItems = {}
        activeItems = {}
        return
    end
    
    local entries = {}
    local entryById = {}
    
    local function addId(id, fallbackType)
        local number = tonumber(id)
        
        if number and number > 0 and not entryById[number] then
            local entry = {
            Id = number,
            AssetType = fallbackType
            }
            
            entryById[number] = entry
            table.insert(entries, entry)
        end
    end
    
    addId(description.Shirt, Enum.AvatarAssetType.Shirt)
    addId(description.Pants, Enum.AvatarAssetType.Pants)
    addId(description.GraphicTShirt, Enum.AvatarAssetType.TShirt)
    addId(description.Head, Enum.AvatarAssetType.Head)
    addId(description.Face, Enum.AvatarAssetType.Face)
    
    local accessoryTypes = {
    {Property = "HatAccessory", Type = Enum.AvatarAssetType.Hat},
    {Property = "HairAccessory", Type = Enum.AvatarAssetType.HairAccessory},
    {Property = "FaceAccessory", Type = Enum.AvatarAssetType.FaceAccessory},
    {Property = "NeckAccessory", Type = Enum.AvatarAssetType.NeckAccessory},
    {Property = "ShouldersAccessory", Type = Enum.AvatarAssetType.ShoulderAccessory},
    {Property = "FrontAccessory", Type = Enum.AvatarAssetType.FrontAccessory},
    {Property = "BackAccessory", Type = Enum.AvatarAssetType.BackAccessory},
    {Property = "WaistAccessory", Type = Enum.AvatarAssetType.WaistAccessory}
    }
    
    for _, accessory in ipairs(accessoryTypes) do
        local value = description[accessory.Property]
        
        if value and value ~= "" then
            for id in string.gmatch(value, "%d+") do
                addId(id, accessory.Type)
            end
        end
    end
    
    local accessorySuccess, accessories = pcall(function()
        return description:GetAccessories(true)
    end)
    
    if accessorySuccess and accessories then
        for _, accessory in ipairs(accessories) do
            addId(
            accessory.AssetId,
            getAssetTypeFromAccessoryType(accessory.AccessoryType)
            )
        end
    end
    
    if requestVersion ~= usingLoadVersion then
        return
    end
    
    clearItems()
    allItems = {}
    activeItems = {}
    
    if #entries == 0 then
        return
    end
    
    local ids = {}
    
    for _, entry in ipairs(entries) do
        table.insert(ids, entry.Id)
    end
    
    local detailsSuccess, details = pcall(function()
        return AvatarEditorService:GetBatchItemDetailsAsync(
        ids,
        Enum.AvatarItemType.Asset
        )
    end)
    
    if requestVersion ~= usingLoadVersion then
        return
    end
    
    if not detailsSuccess or not details then
        return
    end
    
    local usedSearch = string.lower(searchBox.Text or "")
    
    for _, data in ipairs(details) do
        if requestVersion ~= usingLoadVersion then
            return
        end
        
        local id = tonumber(data.Id)
        
        if id then
            local itemName = data.Name or "Item equipado"
            
            local matchesSearch =
            usedSearch == ""
            or string.find(
            string.lower(itemName),
            usedSearch,
            1,
            true
            ) ~= nil
            
            if matchesSearch then
                local entry = entryById[id]
                local assetType = getAssetTypeFromName(data.AssetType)
                
                if not assetType and entry then
                    assetType = entry.AssetType
                end
                
                local item = {
                Id = id,
                Name = itemName,
                Price = data.Price,
                AssetType = assetType,
                IsBundle = false,
                ThumbnailId = id,
                EquipCategory = getCategoryFromAssetType(assetType)
                }
                
                table.insert(allItems, item)
                activeItems[id] = true
                createCard(item)
            end
        end
    end
    
    if requestVersion == usingLoadVersion then
        refreshCards()
    end
end

local function bundleToItem(data, seenIds)
    if not data or not data.Id or not data.Name then
        return nil
    end
    
    local bundleType = string.gsub(
    tostring(data.BundleType or ""),
    "^Enum%.BundleType%.",
    ""
    )
    
    if bundleType == "Shoes" then
        local leftShoe
        local rightShoe
        
        for _, bundledItem in ipairs(data.BundledItems or {}) do
            local bundledType = string.gsub(
            tostring(bundledItem.AssetType or ""),
            "^Enum%.AvatarAssetType%.",
            ""
            )
            
            if bundledType == "LeftShoeAccessory" then
                leftShoe = tonumber(bundledItem.Id)
            elseif bundledType == "RightShoeAccessory" then
                rightShoe = tonumber(bundledItem.Id)
            end
        end
        
        if not leftShoe or not rightShoe then
            return nil
        end
        
        local key = "Bundle:" .. tostring(data.Id)
        
        if seenIds[key] then
            return nil
        end
        
        seenIds[key] = true
        
        return {
        Id = tonumber(data.Id),
        Name = data.Name,
        Price = data.Price,
        AssetType = "ShoePair",
        IsBundle = true,
        ThumbnailId = tonumber(data.Id),
        ThumbnailIsBundle = true,
        EquipCategory = "Sapatos",
        ShoePair = {
        Left = leftShoe,
        Right = rightShoe
        }
        }
    end
    
    if bundleType == "Animations" then
        local key = "Bundle:" .. tostring(data.Id)
        
        if seenIds[key] then
            return nil
        end
        
        seenIds[key] = true
        
        return {
