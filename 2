local function applyClassicClothing(player, humanoid, assetId, assetType)
    local success, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)
    
    if not success or not description then
        return false
    end
    
    local propertyName
    
    if assetType == "TShirt" then
        propertyName = "GraphicTShirt"
    elseif assetType == "Shirt" then
        propertyName = "Shirt"
    elseif assetType == "Pants" then
        propertyName = "Pants"
    else
        return false
    end
    
    local oldId = description[propertyName]
    
    if tonumber(oldId) == tonumber(assetId) then
        description[propertyName] = 0
        
        if not pcall(function()
            humanoid:ApplyDescriptionResetAsync(description)
        end) then
        return false
    end
    
    catalogState[player].Classic[assetType] = nil
    equippedSlots[player][assetType] = nil
    removeEquippedState(player, assetId)
    remote:FireClient(player, "RefreshAvatar")
    
    return true
end
 
local previous = catalogState[player].Classic[assetType]
 
if previous then
    removeEquippedState(player, previous.Id)
    equippedItems[player][previous.Id] = nil
end
 
description[propertyName] = assetId
 
if not pcall(function()
    humanoid:ApplyDescriptionResetAsync(description)
end) then
return false
end
 
catalogState[player].Classic[assetType] = {
Id = assetId,
AssetType = assetType
}
 
equippedSlots[player][assetType] = assetId
equippedItems[player][assetId] = true
 
remote:FireClient(player, "Equipped", assetId, "Item")
remote:FireClient(player, "RefreshAvatar")
 
return true
end
 
