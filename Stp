local function normalizeAssetType(assetType)
    if typeof(assetType) == "EnumItem" then
        return assetType.Name
    end
    
    if typeof(assetType) == "string" then
        return string.gsub(assetType, "^Enum%.AvatarAssetType%.", "")
    end
    
    return nil
end
 
local function stopEmote(player)
    activeEmotes[player] = nil
    activeEmoteNames[player] = nil
    remote:FireClient(player, "StopEmote")
end
 
local function restoreEmoteDescription(player)
    local character = player.Character
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end
    
    local oldDescription = previousEmoteDescriptions[player]
    if not oldDescription then
        return
    end
    
    if activeBundles[player] then
        previousEmoteDescriptions[player] = nil
        return
    end
    
    pcall(function()
        humanoid:ApplyDescriptionResetAsync(oldDescription)
    end)
    
    previousEmoteDescriptions[player] = nil
end
 
local function removeActiveEmote(player)
    local oldEmoteId = activeEmotes[player]
    
    activeEmotes[player] = nil
    activeEmoteNames[player] = nil
    
    if oldEmoteId then
        restoreEmoteDescription(player)
    end
    
    remote:FireClient(player, "StopEmote", nil, oldEmoteId)
end
 
local function getBundleDescription(bundleId)
    local success, details = pcall(function()
        return AssetService:GetBundleDetailsAsync(bundleId)
    end)
    
    if not success or not details then
        return nil
    end
    
    local outfitId
    
    for _, item in ipairs(details.Items or {}) do
        if item.Type == "UserOutfit" then
            outfitId = item.Id
            break
        end
    end
    
    if not outfitId then
        return nil
    end
    
    local success2, description = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
    end)
    
    if success2 then
        return description
    end
    
    return nil
end
 
local function copyCharacterOnly(fromDescription, toDescription)
    if not fromDescription or not toDescription then
        return
    end
    
    toDescription.Head = fromDescription.Head
    toDescription.LeftArm = fromDescription.LeftArm
    toDescription.RightArm = fromDescription.RightArm
    toDescription.LeftLeg = fromDescription.LeftLeg
    toDescription.RightLeg = fromDescription.RightLeg
    toDescription.Torso = fromDescription.Torso
    toDescription.Face = fromDescription.Face
    
    toDescription.BodyTypeScale = fromDescription.BodyTypeScale
    toDescription.DepthScale = fromDescription.DepthScale
    toDescription.HeadScale = fromDescription.HeadScale
    toDescription.HeightScale = fromDescription.HeightScale
    toDescription.ProportionScale = fromDescription.ProportionScale
    toDescription.WidthScale = fromDescription.WidthScale
    toDescription.StaticFacialAnimation = fromDescription.StaticFacialAnimation
end
 
local function copyAnimations(fromDescription, toDescription)
    toDescription.ClimbAnimation = fromDescription.ClimbAnimation
    toDescription.FallAnimation = fromDescription.FallAnimation
    toDescription.IdleAnimation = fromDescription.IdleAnimation
    toDescription.JumpAnimation = fromDescription.JumpAnimation
