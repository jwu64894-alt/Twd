local function applyCharacterBundle(player, bundleId)
    local character = player.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return
    end
    
    local bundleDescription = getBundleDescription(bundleId)
    
    if not bundleDescription then
        return
    end
    
    if activeBundles[player] == bundleId then
        local oldCharacterDescription = previousCharacterDescriptions[player]
        
        if oldCharacterDescription then
            local currentDescription = humanoid:GetAppliedDescription()
            
            if currentDescription then
                copyCharacterOnly(
                oldCharacterDescription,
                currentDescription
                )
                
                if not pcall(function()
                    humanoid:ApplyDescriptionResetAsync(currentDescription)
                end) then
                return
            end
        end
    end
    
    activeBundles[player] = nil
    previousCharacterDescriptions[player] = nil
    equippedItems[player][bundleId] = nil
    
    remote:FireClient(player, "Unequipped", bundleId)
    remote:FireClient(player, "RefreshAvatar")
    
    return
end
 
local success, currentDescription = pcall(function()
    return humanoid:GetAppliedDescription()
end)
 
if not success or not currentDescription then
    return
end
 
previousCharacterDescriptions[player] = currentDescription:Clone()
 
local newDescription = currentDescription:Clone()
 
copyCharacterOnly(
bundleDescription,
newDescription
)
 
if not pcall(function()
    humanoid:ApplyDescriptionResetAsync(newDescription)
end) then
return
end
 
local oldBundle = activeBundles[player]
 
if oldBundle then
    remote:FireClient(player, "Unequipped", oldBundle)
    equippedItems[player][oldBundle] = nil
end
 
activeBundles[player] = bundleId
equippedItems[player][bundleId] = true
 
remote:FireClient(player, "Equipped", bundleId, "Personagens")
remote:FireClient(player, "RefreshAvatar")
end
 
local function applyCatalogItem(player, category, assetId, assetType, shoePair)
    local character = player.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return
    end
    
    assetType = normalizeAssetType(assetType)
    
    if category == "Sapatos" then
        if typeof(shoePair) ~= "table" then
            removeShoePairById(player, humanoid, assetId)
        else
            applyShoePair(
            player,
            humanoid,
            assetId,
            shoePair
            )
        end
        
        return
    end
    
    if not assetType then
        return
    end
    
    if activeEmotes[player] then
        removeActiveEmote(player)
    end
    
    if category == "Roupas 2D" then
        applyClassicClothing(
        player,
        humanoid,
        assetId,
        assetType
        )
        
    elseif category == "Cabeças" then
        applyHead(
        player,
        humanoid,
        assetId
        )
        
    elseif category == "Cabelos" then
        toggleAccessory(
        player,
        humanoid,
        assetId,
        "HairAccessory",
        false
        )
        
    elseif category == "Acessórios" then
        toggleAccessory(
        player,
        humanoid,
        assetId,
        assetType,
        false
        )
        
    elseif category == "Roupas 3D" then
        toggleAccessory(
        player,
        humanoid,
        assetId,
        assetType,
        true
        )
    end
end
 
local function reapplyCatalogItems(player)
    local character = player.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return
    end
    
    local state = catalogState[player]
    
    if not state then
        return
    end
    
    local success, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)
    
    if not success or not description then
        return
    end
    
    if activeBundles[player] then
        local bundleDescription = getBundleDescription(
        activeBundles[player]
        )
        
        if bundleDescription then
            copyCharacterOnly(
            bundleDescription,
            description
            )
        end
    end
    
    for assetType, item in pairs(state.Classic) do
        if item and item.Id then
            if assetType == "TShirt" then
                description.GraphicTShirt = item.Id
            elseif assetType == "Shirt" then
                description.Shirt = item.Id
            elseif assetType == "Pants" then
                description.Pants = item.Id
            end
        end
    end
    
    if state.Head and state.Head.Id then
        description.Head = state.Head.Id
    end
    
    local allAccessories = description:GetAccessories(true)
    local existingIds = {}
    
    for _, accessory in ipairs(allAccessories) do
        existingIds[tonumber(accessory.AssetId)] = true
    end
    
    for _, savedItem in pairs(state.Accessories) do
        if savedItem
            and savedItem.Id
            and savedItem.AssetType then
            
            local accessoryType
            
            if isShoeAssetType(savedItem.AssetType) then
                accessoryType = getShoeAccessoryType(
                savedItem.AssetType
                )
            elseif savedItem.IsLayered then
                accessoryType =
                layeredAccessoryTypes[savedItem.AssetType]
            else
                accessoryType =
                rigidAccessoryTypes[savedItem.AssetType]
            end
            
            if accessoryType
                and not existingIds[tonumber(savedItem.Id)] then
                
                local newAccessory = {
                AssetId = savedItem.Id,
                AccessoryType = accessoryType
                }
                
                if savedItem.IsLayered then
                    newAccessory.IsLayered = true
                    newAccessory.Order =
                    savedItem.Order
                    or getFreeLayeredOrder(allAccessories)
                end
                
                table.insert(
                allAccessories,
                newAccessory
                )
                
                existingIds[tonumber(savedItem.Id)] = true
            end
        end
    end
    
    if not pcall(function()
        description:SetAccessories(
        allAccessories,
        true
        )
    end) then
    return
end
 
if not pcall(function()
    humanoid:ApplyDescriptionResetAsync(description)
end) then
return
end
 
equippedItems[player] = {}
equippedSlots[player] = {}
 
for assetType, item in pairs(state.Classic) do
    if item and item.Id then
        equippedItems[player][item.Id] = true
        equippedSlots[player][assetType] = item.Id
    end
end
 
if state.Head and state.Head.Id then
    equippedItems[player][state.Head.Id] = true
    equippedSlots[player].Head = state.Head.Id
end
 
for _, item in pairs(state.Accessories) do
    if item and item.Id then
        equippedItems[player][item.Id] = true
    end
end
 
if state.Shoes and state.Shoes.BundleId then
    equippedItems[player][state.Shoes.BundleId] = true
end
 
if activeBundles[player] then
    equippedItems[player][activeBundles[player]] = true
end
 
remote:FireClient(player, "ClearEquipped")
 
for itemId in pairs(equippedItems[player]) do
    if activeBundles[player]
        and itemId == activeBundles[player] then
        
        remote:FireClient(
        player,
        "Equipped",
        itemId,
        "Personagens"
        )
        
    elseif state.Shoes
        and itemId == state.Shoes.BundleId then
        
        remote:FireClient(
        player,
        "Equipped",
        itemId,
        "Sapatos"
        )
        
    else
        remote:FireClient(
        player,
        "Equipped",
        itemId,
        "Item"
        )
    end
end
 
remote:FireClient(player, "RefreshAvatar")
end
 
remote.OnServerEvent:Connect(function(
    player,
    category,
    id,
    name,
    assetType,
    shoePair,
    isBundle
    )
    local numericId = tonumber(id)
    
    if not numericId or numericId <= 0 then
        return
    end
    
    if not equippedItems[player] then
        initializePlayer(player)
    end
    
    if category == "Comprar" then
        local purchaseItems
        
        if isBundle == true then
            purchaseItems = {
            {
            Type = Enum.MarketplaceProductType.AvatarBundle,
            Id = tostring(numericId)
            }
            }
        else
            purchaseItems = {
            {
            Type = Enum.MarketplaceProductType.AvatarAsset,
            Id = tostring(numericId)
            }
            }
        end
        
        local success, err = pcall(function()
            MarketplaceService:PromptBulkPurchase(
            player,
            purchaseItems,
            {}
            )
        end)
        
        if not success then
            warn(
            "Não foi possível abrir a compra do catálogo:",
            numericId,
            err
            )
        end
        
        return
    end
    
    if category == "Emotes" then
        toggleEmote(
        player,
        numericId,
        name
        )
        
        return
    end
    
    if category == "Animações" then
        applyAnimationBundle(
        player,
        numericId
        )
        
        return
    end
    
    if category == "Personagens" then
        applyCharacterBundle(
        player,
        numericId
        )
        
        return
    end
    
    if category == "Sapatos" then
        local character = player.Character
        
        if not character then
            return
        end
        
        local humanoid =
        character:FindFirstChildOfClass("Humanoid")
        
        if not humanoid then
            return
        end
        
        if typeof(shoePair) ~= "table" then
            removeShoePairById(
            player,
            humanoid,
            numericId
            )
        else
            applyCatalogItem(
            player,
            category,
            numericId,
            assetType,
            shoePair
            )
        end
        
        return
    end
    
    if category == "Roupas 2D"
        or category == "Roupas 3D"
        or category == "Cabelos"
        or category == "Cabeças"
        or category == "Acessórios" then
        
        if typeof(assetType) ~= "string"
            and typeof(assetType) ~= "EnumItem" then
            return
        end
        
        applyCatalogItem(
        player,
        category,
        numericId,
        assetType
        )
    end
end)
 
local function setupCharacter(player)
    player.CharacterAdded:Connect(function(character)
        activeEmotes[player] = nil
        activeEmoteNames[player] = nil
        previousDescriptions[player] = nil
        previousEmoteDescriptions[player] = nil
        
        equippedItems[player] = {}
        equippedSlots[player] = {}
        
        local humanoid =
        character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild(
        "Humanoid",
        5
        )
        
        if humanoid then
            task.defer(function()
                reapplyCatalogItems(player)
            end)
        else
            remote:FireClient(
            player,
            "ClearEquipped"
            )
            
            remote:FireClient(
            player,
            "RefreshAvatar"
            )
        end
    end)
end
 
Players.PlayerAdded:Connect(function(player)
    initializePlayer(player)
    setupCharacter(player)
end)
 
for _, player in ipairs(Players:GetPlayers()) do
    initializePlayer(player)
    setupCharacter(player)
end
 
Players.PlayerRemoving:Connect(function(player)
    activeEmotes[player] = nil
    activeEmoteNames[player] = nil
    activeBundles[player] = nil
    previousDescriptions[player] = nil
    previousCharacterDescriptions[player] = nil
    previousEmoteDescriptions[player] = nil
    equippedItems[player] = nil
    equippedSlots[player] = nil
    catalogState[player] = nil
end)
