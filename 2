local function isShoeAssetType(assetType)
    return assetType == "LeftShoeAccessory"
    or assetType == "RightShoeAccessory"
end
 
local function getShoeAccessoryType(assetType)
    if assetType == "LeftShoeAccessory" then
        return Enum.AccessoryType.LeftShoe
    elseif assetType == "RightShoeAccessory" then
        return Enum.AccessoryType.RightShoe
    end
    
    return nil
end
 
local function getFreeLayeredOrder(accessories)
    local usedOrders = {}
    
    for _, accessory in ipairs(accessories) do
        if accessory.Order ~= nil then
            usedOrders[tonumber(accessory.Order)] = true
        end
    end
    
    local order = 1
    
    while usedOrders[order] do
        order += 1
    end
    
    return order
end
 
local function clearSavedShoes(player)
    local state = catalogState[player]
    
    if not state then
        return
    end
    
    for savedId, savedItem in pairs(state.Accessories) do
        if savedItem
            and savedItem.AssetType
            and isShoeAssetType(savedItem.AssetType) then
            
            state.Accessories[savedId] = nil
        end
    end
    
    state.Shoes = nil
end
 
local function removeShoePairById(player, humanoid, itemId)
    local state = catalogState[player]
    
    if not state or not state.Shoes then
        return false
    end
    
    local shoes = state.Shoes
    local bundleId = tonumber(shoes.BundleId)
    local leftId = tonumber(shoes.LeftId)
    local rightId = tonumber(shoes.RightId)
    local clickedId = tonumber(itemId)
    
    if not clickedId then
        return false
    end
    
    if clickedId ~= bundleId
        and clickedId ~= leftId
        and clickedId ~= rightId then
        return false
    end
    
    local success, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)
    
    if not success or not description then
        return false
    end
    
    local accessories = description:GetAccessories(true)
    local filtered = {}
    
    for _, accessory in ipairs(accessories) do
        if accessory.AccessoryType ~= Enum.AccessoryType.LeftShoe
            and accessory.AccessoryType ~= Enum.AccessoryType.RightShoe then
            
            table.insert(filtered, accessory)
        end
    end
    
    if not pcall(function()
        description:SetAccessories(filtered, true)
    end) then
    return false
end
 
