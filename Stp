local function appendHeadsPage(requestVersion)
    local state = categoryCatalogState
    
    if not state or state.loading then
        return false
    end
    
    state.loading = true
    
    local added = 0
    
    while added < CATALOG_PAGE_SIZE do
        if requestVersion ~= catalogRequestVersion then
            state.loading = false
            return false
        end
        
        for _, source in ipairs(state.sources) do
            if #source.buffer == 0 and not source.finished then
                fillHeadSource(state, source, requestVersion)
            end
        end
        
        local availableSources = {}
        
        for _, source in ipairs(state.sources) do
            if #source.buffer > 0 then
                table.insert(availableSources, source)
            end
        end
        
        if #availableSources == 0 then
            break
        end
        
        state.roundRobin += 1
        
        local sourceIndex =
        ((state.roundRobin - 1) % #availableSources) + 1
        
        local source = availableSources[sourceIndex]
        local item = table.remove(source.buffer, 1)
        
        if item then
            table.insert(allItems, item)
            createCard(item)
            added += 1
        end
    end
    
    local finished = true
    
    for _, source in ipairs(state.sources) do
        if not source.finished or #source.buffer > 0 then
            finished = false
            break
        end
    end
    
    state.finished = finished
    state.loading = false
    
    refreshCards()
    
    return added > 0
end

local function loadHeads(keyword, sortType, requestVersion)
    clearItems()
    allItems = {}
    
    categoryCatalogState = {
    requestVersion = requestVersion,
    category = "Cabeças",
    sources = {},
    seenIds = {},
    roundRobin = 0,
    finished = false,
    loading = false
    }
    
    local state = categoryCatalogState
    
    local sourceTypes = {
    {AssetType = Enum.AvatarAssetType.Head},
    {AssetType = Enum.AvatarAssetType.Face},
    {AssetType = Enum.AvatarAssetType.DynamicHead},
    {BundleType = Enum.BundleType.DynamicHead},
    {BundleType = Enum.BundleType.DynamicHeadAvatar}
    }
    
    local pending = #sourceTypes
    
    for _, sourceType in ipairs(sourceTypes) do
        task.spawn(function()
            local success, pages = pcall(function()
                return createHeadSource(
                keyword,
                sortType,
                sourceType
                )
            end)
            
            if requestVersion == catalogRequestVersion
                and success
                and pages then
                
                table.insert(state.sources, {
                sourceType = sourceType,
                pages = pages,
                buffer = {},
                finished = false
                })
            end
            
            pending -= 1
            
            if pending <= 0
                and requestVersion == catalogRequestVersion then
                appendHeadsPage(requestVersion)
            end
        end)
    end
end

