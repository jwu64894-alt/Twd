local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetService = game:GetService("AssetService")
local MarketplaceService = game:GetService("MarketplaceService")
 
local remote = ReplicatedStorage:FindFirstChild("CatalogRemote")
 
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "CatalogRemote"
    remote.Parent = ReplicatedStorage
end
 
local activeEmotes = {}
local activeEmoteNames = {}
local activeBundles = {}
local previousDescriptions = {}
local previousCharacterDescriptions = {}
local previousEmoteDescriptions = {}
local equippedItems = {}
local equippedSlots = {}
local catalogState = {}
 
local function initializePlayer(player)
    equippedItems[player] = {}
    equippedSlots[player] = {}
    
    if not catalogState[player] then
        catalogState[player] = {
        Classic = {},
        Head = nil,
        Accessories = {},
        Shoes = nil
        }
    end
end
 
local function normalizeAssetType(assetType)
    if typeof(assetType) == "EnumItem" then
        return assetType.Name
    end
    
    if typeof(assetType) == "string" then
        return string.gsub(assetType, "^Enum%.AvatarAssetType%.", "")
    end
    
    return nil
end
 
local function stopEmote(player)
    activeEmotes[player] = nil
    activeEmoteNames[player] = nil
    remote:FireClient(player, "StopEmote")
end
 
local function restoreEmoteDescription(player)
    local character = player.Character
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end
    
    local oldDescription = previousEmoteDescriptions[player]
    if not oldDescription then
        return
    end
    
    if activeBundles[player] then
        previousEmoteDescriptions[player] = nil
        return
    end
    
    pcall(function()
        humanoid:ApplyDescriptionResetAsync(oldDescription)
    end)
    
    previousEmoteDescriptions[player] = nil
end
 
local function removeActiveEmote(player)
    local oldEmoteId = activeEmotes[player]
    
    activeEmotes[player] = nil
    activeEmoteNames[player] = nil
    
    if oldEmoteId then
        restoreEmoteDescription(player)
    end
    
    remote:FireClient(player, "StopEmote", nil, oldEmoteId)
end
 
local function getBundleDescription(bundleId)
    local success, details = pcall(function()
        return AssetService:GetBundleDetailsAsync(bundleId)
    end)
    
    if not success or not details then
        return nil
    end
    
    local outfitId
    
    for _, item in ipairs(details.Items or {}) do
        if item.Type == "UserOutfit" then
            outfitId = item.Id
            break
        end
    end
    
    if not outfitId then
        return nil
    end
    
    local success2, description = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
    end)
    
    if success2 then
        return description
    end
    
    return nil
end
 
local function copyCharacterOnly(fromDescription, toDescription)
    if not fromDescription or not toDescription then
        return
    end
    
    toDescription.Head = fromDescription.Head
    toDescription.LeftArm = fromDescription.LeftArm
    toDescription.RightArm = fromDescription.RightArm
    toDescription.LeftLeg = fromDescription.LeftLeg
    toDescription.RightLeg = fromDescription.RightLeg
    toDescription.Torso = fromDescription.Torso
    toDescription.Face = fromDescription.Face
    
    toDescription.BodyTypeScale = fromDescription.BodyTypeScale
    toDescription.DepthScale = fromDescription.DepthScale
    toDescription.HeadScale = fromDescription.HeadScale
    toDescription.HeightScale = fromDescription.HeightScale
    toDescription.ProportionScale = fromDescription.ProportionScale
    toDescription.WidthScale = fromDescription.WidthScale
    toDescription.StaticFacialAnimation = fromDescription.StaticFacialAnimation
end
 
local function copyAnimations(fromDescription, toDescription)
    toDescription.ClimbAnimation = fromDescription.ClimbAnimation
    toDescription.FallAnimation = fromDescription.FallAnimation
    toDescription.IdleAnimation = fromDescription.IdleAnimation
    toDescription.JumpAnimation = fromDescription.JumpAnimation
    toDescription.MoodAnimation = fromDescription.MoodAnimation
    toDescription.RunAnimation = fromDescription.RunAnimation
    toDescription.SwimAnimation = fromDescription.SwimAnimation
    toDescription.WalkAnimation = fromDescription.WalkAnimation
end
 
local function removeEquippedState(player, itemId)
    if equippedItems[player] then
        equippedItems[player][itemId] = nil
    end
    
    remote:FireClient(player, "Unequipped", itemId)
end
 
local function applyAnimationBundle(player, bundleId)
    local character = player.Character
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end
    
    if activeBundles[player] == bundleId then
        local oldDescription = previousDescriptions[player]
        
        if oldDescription then
            removeActiveEmote(player)
            
            local success = pcall(function()
                humanoid:ApplyDescriptionResetAsync(oldDescription)
            end)
            
            if success then
                activeBundles[player] = nil
                previousDescriptions[player] = nil
                
                remote:FireClient(player, "Unequipped", bundleId)
                remote:FireClient(player, "RefreshAvatar")
            end
        end
        
        return
    end
    
    local currentDescription
    
    local success = pcall(function()
        currentDescription = humanoid:GetAppliedDescription()
    end)
    
    if not success or not currentDescription then
        return
    end
    
    local bundleDescription = getBundleDescription(bundleId)
    
    if not bundleDescription then
        warn("Não foi possível obter o bundle:", bundleId)
        return
    end
    
    previousDescriptions[player] = currentDescription:Clone()
    
    local newDescription = currentDescription:Clone()
    
    copyAnimations(bundleDescription, newDescription)
    removeActiveEmote(player)
    
    local applied = pcall(function()
        humanoid:ApplyDescriptionResetAsync(newDescription)
    end)
    
    if not applied then
        return
    end
    
    if activeBundles[player] then
        remote:FireClient(player, "Unequipped", activeBundles[player])
    end
    
    activeBundles[player] = bundleId
    
    remote:FireClient(player, "Equipped", bundleId, "Animações")
    remote:FireClient(player, "RefreshAvatar")
end
 
local function toggleEmote(player, emoteId, emoteName)
    local character = player.Character
    
    if not character then
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then
        return
    end
    
    if activeEmotes[player] == emoteId then
        removeActiveEmote(player)
        return
    end
    
    if activeEmotes[player] then
        removeActiveEmote(player)
    end
    
    local currentDescription
    
    local success = pcall(function()
        currentDescription = humanoid:GetAppliedDescription()
    end)
    
    if not success or not currentDescription then
        return
    end
    
    previousEmoteDescriptions[player] = currentDescription:Clone()
    
    local internalName = "CatalogEmote_" .. tostring(emoteId)
    
    local added = pcall(function()
        currentDescription:AddEmote(internalName, emoteId)
        currentDescription:SetEquippedEmotes({internalName})
    end)
    
    if not added then
        previousEmoteDescriptions[player] = nil
        warn("Não foi possível adicionar o emote:", emoteId)
        return
    end
    
    local applied = pcall(function()
        humanoid:ApplyDescriptionResetAsync(currentDescription)
    end)
    
    if not applied then
        previousEmoteDescriptions[player] = nil
        return
    end
    
    activeEmotes[player] = emoteId
    activeEmoteNames[player] = internalName
    
    remote:FireClient(player, "PlayEmote", internalName, emoteId)
    remote:FireClient(player, "Equipped", emoteId, "Emotes")
end
 
